#include <stdio.h>

int main() {
    float vendas[7];
    int diaMaior = 0;

    for (int i = 0; i < 7; i++) {
        printf("Digite a venda do dia %d: ", i + 1);
        scanf("%f", &vendas[i]);

        if (vendas[i] > vendas[diaMaior]) {
            diaMaior = i;
        }
    }
    printf("\nA maior venda foi no dia %d", diaMaior + 1);
    printf("\nValor da maior venda: %.2f\n", vendas[diaMaior]);

    return 0;
}
