#include <stdio.h>

int main() {
    int idades[10];
    int convite;
    int i;

    int permitidas = 0;
    int negadas = 0;

    int maiorIdade = 0;

    for (i = 0; i < 10; i++) {
        printf("Digite a idade da pessoa %d: ", i + 1);
        scanf("%d", &idades[i]);
    }

    printf("Digite o número do convite (1 para permitido, 0 para negado): ");
    scanf("%d", &convite);
    for (i = 0; i < 10; i++) {
        if (convite == 1 && idades[i] >= 18) {
            permitidas++;
            if (idades[i] > maiorIdade) {
                maiorIdade = idades[i];
            }
        } else {
            negadas++;
        }
    }
    
    return 0;
}
