#include <stdio.h>

int main() {
    int num;
    int maior, menor;

    for (int i = 0; i < 5; i++) {
        printf("Digite um número: ");
        scanf("%d", &num);

        if (i == 0) {
            maior = num;
            menor = num;
        } else {
            if (num > maior) {
                maior = num;
            }
            if (num < menor) {
                menor = num;
            }
        }
    }

    printf("\nMaior número: %d\n", maior);
    printf("Menor número: %d\n", menor);

    return 0;
}
