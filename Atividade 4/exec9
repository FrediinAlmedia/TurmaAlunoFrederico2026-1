#include <stdio.h>

int main() {
    int num;
    int positivos = 0, negativos = 0, zeros = 0;

    for (int i = 0; i < 10; i++) {
        printf("Digite um número: ");
        scanf("%d", &num);

        if (num > 0) {
            positivos++;
        } else if (num < 0) {
            negativos++;
        } else {
            zeros++;
        }
    }
    
    printf("\nPositivos: %d\n", positivos);
    printf("Negativos: %d\n", negativos);
    printf("Zeros: %d\n", zeros);

    return 0;
}
